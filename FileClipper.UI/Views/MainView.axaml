<UserControl
    x:Class="FileClipper.UI.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FileClipper.UI.ViewModels"
    d:DesignHeight="550"
    d:DesignWidth="600"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d"
	Background="Transparent">
    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainViewModel />
    </Design.DataContext>
	<StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
		<StackPanel.Background>
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,75%">
				<GradientStop Color="#A8BBBF" Offset="0.0"/>
				<GradientStop Color="#BFB28A" Offset="1.0"/>
			</LinearGradientBrush>
		</StackPanel.Background>
		
		<StackPanel HorizontalAlignment="Center" Margin="10">
			<Border CornerRadius="30" ClipToBounds="True" Width="400">
				<Image Source="{SvgImage /Assets/logo_v2.svg}"/>
			</Border>
			<Label Content="{Binding Version}" HorizontalContentAlignment="Center"/>
		</StackPanel>

        <!-- Directory Selection -->
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
			<TextBox HorizontalAlignment="Stretch" MinWidth="500" 
                     Text="{Binding DirectoryToScanPath}"
                     Watermark="Select a directory to scan..."/>
			<Button HorizontalAlignment="Stretch" Content="..." 
                    Command="{Binding BrowseDirectoryCommand}"
                    Background="#2F403E" Foreground="White" Margin="5 0 0 0"/>
		</StackPanel>

        <!-- File Extensions Selection -->
        <StackPanel HorizontalAlignment="Center" Margin="10">
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto">
                <TextBlock Text="Select File Extensions:" HorizontalAlignment="Center" 
                           VerticalAlignment="Center" Margin="0 0 10 5" Grid.Column="0"/>
                <Button Content="Refresh" Command="{Binding RefreshExtensionsCommand}" 
                        Grid.Column="1" Padding="5 2" Background="#2F403E" Foreground="White"/>
            </Grid>
            <ListBox HorizontalAlignment="Center" MinWidth="300" Margin="0 10 0 0"
                     ItemsSource="{Binding ExtensionsScanned}"
                     SelectedItems="{Binding SelectedExtensions}"
					 SelectionMode="Multiple"
					 Height="150"/>
        </StackPanel>
        
        <!-- Options -->
		<CheckBox HorizontalAlignment="Center" Content="Include Subfolders" 
                  IsChecked="{Binding IncludeSubdirectories}"
                  Margin="10"/>
        
        <!-- Action Button -->
		<Button HorizontalAlignment="Center" Content="Save to Clipboard" 
                Command="{Binding SaveToClipboardCommand}"
                Margin="15" Padding="10 5" 
                Background="#2F403E" Foreground="White"/>
        
        <!-- Status Message -->
        <Border Background="#33000000" CornerRadius="5" Margin="10" Padding="10" 
                HorizontalAlignment="Center" MaxWidth="500"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding StatusMessage}" 
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
	</StackPanel>
</UserControl>
